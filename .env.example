# API runtime config (NestJS)

# Server
PORT=3000

# Interactive OpenAPI (Swagger UI) at http://localhost:PORT/api/docs — see docs/sops/SOP_API_MANUAL_TESTING.md
# true | false | unset (unset = on when NODE_ENV is not production)
# API_OPENAPI=true

# Auth
# IMPORTANT: use a long random value in production; keep dev simple.
JWT_SECRET=development-secret
# Optional: when set, POST /auth/login may send header `X-Fordan-Smoke-Secret` with the same
# value so login does not append `system_audit_logs` rows (CI / scripts/api-smoke.sh).
# API_SMOKE_SECRET=

# 32-byte hex key for encrypting sensitive settings persisted in the database.
# Generate with: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database (Docker Compose defaults)
#
# Dialect can be switched for constrained hosts (e.g. cPanel):
# - postgres (default)
# - mysql
# - mariadb
DB_DIALECT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=fordan

# Postgres TLS (managed Postgres)
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# MySQL/MariaDB (common on cPanel)
# If MySQL TCP port is not reachable but a local socket is available, set:
# DATABASE_SOCKET_PATH=/var/lib/mysql/mysql.sock
DATABASE_SOCKET_PATH=

# Schema safety
# - dev default: true (fast iteration)
# - production recommended: false + migrations
DATABASE_SYNCHRONIZE=true

# Seeding
# - dev default: true (seed default accounts)
# - production recommended: false (run seed script explicitly once)
SEED_DEFAULT_USERS=true

# Installer endpoints (dev-only; guard with JWT + RBAC)
INSTALLER_ENABLED=true

# File uploads (future-ready; implement in API when needed)
# STORAGE_DRIVER=local|s3
STORAGE_DRIVER=local

# Local storage (dev only)
LOCAL_UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp

# S3-compatible (prod or MinIO dev)
UPLOADS_ENV=dev
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FILE_UPLOADS_BUCKET=file-uploads-dev
S3_COMPLIANCE_UPLOADS_BUCKET=compliance-uploads-dev
# Legacy single-bucket fallback (prefer the two vars above for new setups)
S3_BUCKET=
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# Public progressive lead form (POST /api/public/leads)
# UUID of an existing CRM user used to attribute meter rows, timeline, and notes (e.g. first admin from seed).
PUBLIC_LEAD_ACTOR_USER_ID=
# Optional shared secret; when set, require header X-Public-Lead-Secret or body submissionSecret to match.
PUBLIC_LEAD_SUBMISSION_SECRET=
# Rate limit (per IP) for POST /public/leads only
PUBLIC_LEAD_THROTTLE_TTL_MS=60000
PUBLIC_LEAD_THROTTLE_LIMIT=12

# Public web app base URL used in staff welcome emails (`/login` is appended)
WEB_APP_URL=http://localhost:5173

# Transactional email (optional — leave SMTP_HOST empty to disable all sends)
# Admins can also configure SMTP under Settings → Mail in the web app; when smtpHost
# is saved in admin_settings, it overrides these env vars for outbound mail.
# SMTP is the only supported outbound transport in this API.
# Optional: set EMAIL_PROVIDER=smtp (or leave unset). Any other value is invalid.
# EMAIL_PROVIDER=smtp
# If your SMTP server verifies senders strictly, leave MAIL_FROM blank to reuse
# SMTP_USER or set it to a mailbox / alias the server explicitly allows.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Fordan Solar

# Email open tracking (optional)
# Public base URL of this API (no trailing slash), used for tracking pixels inside emails.
# Example: https://api.fordan.com.au
PUBLIC_API_BASE_URL=
# Comma-separated — internal notification on each public lead submit
LEAD_NOTIFY_EMAILS=
# New staff welcome emails use the `welcome.hbs` template and link to WEB_APP_URL/login
# true | false — send auto-reply to prospect email after public form submit
PUBLIC_LEAD_SEND_CONFIRMATION_EMAIL=false
# Optional overrides for confirmation email (plain text). Use {firstName} placeholder in body if needed.
# PUBLIC_LEAD_CONFIRMATION_SUBJECT=We received your enquiry
# PUBLIC_LEAD_CONFIRMATION_BODY=Hi {firstName},\n\nThanks for reaching out.

# E-signatures (customer quotation signing — custom MVP)
# Optional env fallbacks when not set in Admin Settings (PATCH /settings): esignPublicBaseUrl, esignTokenTtlDays
# Web origin where customers open /sign/:token (no trailing slash), e.g. http://localhost:5173 or https://crm.example.com
ESIGN_PUBLIC_BASE_URL=
# Signing link lifetime in days (default 14, max 90)
ESIGN_TOKEN_TTL_DAYS=14
# When ESIGN_PUBLIC_BASE_URL and Admin Settings are empty: comma-separated allowed web origins for signing links (e.g. https://crm.example.com,https://staging.example.com)
# ESIGN_ALLOWED_PUBLIC_ORIGINS=
# Dangerous: accept any browser Origin / X-Public-Web-Base-Url as the signing base (default off). Prefer ESIGN_ALLOWED_PUBLIC_ORIGINS in production.
# ESIGN_TRUST_BROWSER_ORIGIN=false
