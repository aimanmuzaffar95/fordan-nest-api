<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <title>Welcome to Fordan Solar</title>
</head>
<body style="margin:0;padding:0;background-color:#f2f4f6;font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#191c1e;-webkit-text-size-adjust:100%;">
  <!-- Preheader: shows in inbox preview, hidden in the email body -->
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">Your Fordan Solar CRM staff account is ready — sign in with your temporary password.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f2f4f6;">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:100%;background-color:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #eceef0;">

          <!-- Header -->
          <tr>
            <td style="padding:20px 32px;border-bottom:1px solid #eceef0;font-size:22px;line-height:1.2;font-weight:800;color:#855300;letter-spacing:-0.02em;">Fordan Solar CRM</td>
          </tr>

          <!-- Hero -->
          <tr>
            <td style="padding:36px 32px;background-color:#2d3133;">
              <p style="margin:0 0 10px;font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#ffddb8;">Staff account</p>
              <h1 style="margin:0 0 12px;font-size:26px;line-height:1.25;font-weight:800;color:#ffffff;">Welcome aboard, {{firstName}}.</h1>
              <p style="margin:0;font-size:16px;line-height:1.6;color:rgba(239,241,243,0.84);">Your staff account has been created. Use the details below for your first sign-in.</p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:28px 32px 32px;">
              <p style="margin:0 0 20px;font-size:15px;line-height:1.7;color:#534434;">For security, you will be prompted to change this temporary password right after you log in.</p>

              <!-- Account details -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;background-color:#f7f9fb;border:1px solid #eceef0;border-radius:10px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <p style="margin:0 0 10px;font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#534434;">Account details</p>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size:14px;line-height:1.5;color:#191c1e;">
                      <tr>
                        <td width="170" style="padding:3px 12px 3px 0;color:#534434;white-space:nowrap;">Role</td>
                        <td style="padding:3px 0;">{{staffTypeLabel}}</td>
                      </tr>
                      {{#if staffRoleName}}
                      <tr>
                        <td width="170" style="padding:3px 12px 3px 0;color:#534434;white-space:nowrap;">Staff role</td>
                        <td style="padding:3px 0;">{{staffRoleName}}</td>
                      </tr>
                      {{/if}}
                      <tr>
                        <td width="170" style="padding:3px 12px 3px 0;color:#534434;white-space:nowrap;">Username</td>
                        <td style="padding:3px 0;font-weight:700;">{{username}}</td>
                      </tr>
                      <tr>
                        <td width="170" style="padding:3px 12px 3px 0;color:#534434;white-space:nowrap;">Temporary password</td>
                        <td style="padding:3px 0;font-weight:700;font-family:Consolas,Menlo,monospace;">{{temporaryPassword}}</td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- CTA button (table-based for Outlook) -->
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
                <tr>
                  <td style="border-radius:10px;background-color:#855300;">
                    <a href="{{loginUrl}}" target="_blank" style="display:inline-block;padding:14px 28px;border-radius:10px;font-size:16px;font-weight:700;line-height:1.2;color:#ffffff;text-decoration:none;">Open CRM login</a>
                  </td>
                </tr>
              </table>

              <p style="margin:0;font-size:13px;line-height:1.6;color:#534434;">If you have any questions or need assistance, contact your administrator or reply to this email.</p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding:24px 32px;background-color:#f7f9fb;border-top:1px solid #eceef0;">
              <p style="margin:0 0 4px;font-size:12px;line-height:1.6;color:#534434;">&copy; {{currentYear}} Fordan Solar. All rights reserved.</p>
              <p style="margin:0;font-size:12px;line-height:1.6;color:#534434;">This email contains temporary login credentials intended only for the staff member named above.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
