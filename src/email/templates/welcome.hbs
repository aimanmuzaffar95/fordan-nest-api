<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to Fordan Solar</title>
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f3f3f7; color: #2f3337; margin: 0; padding: 40px 20px;">
    
    <div style="max-width: 600px; margin: 0 auto;">
        <!-- Header / Logo Area -->
        <div style="text-align: center; margin-bottom: 32px;">
            <p style="font-size: 24px; font-weight: bold; color: #1a56db; letter-spacing: -0.5px; margin: 0;">Fordan Solar CRM</p>
        </div>

        <!-- Main Content Card -->
        <div style="background-color: #ffffff; border-radius: 24px; padding: 48px 40px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02);">
            
            <h1 style="margin: 0 0 24px; font-size: 28px; line-height: 1.3; font-weight: 700; color: #1a56db;">
                Welcome to Fordan Solar, {{firstName}}!
            </h1>
            
            <p style="margin: 0 0 20px; font-size: 16px; line-height: 1.6; color: #4b5563;">
                Your staff account has been created. Use the login details below to access the Fordan Solar CRM and complete your first sign-in.
            </p>

            <p style="margin: 0 0 32px; font-size: 16px; line-height: 1.6; color: #4b5563;">
                For security, you will be prompted to change this temporary password after you log in.
            </p>

            <div style="margin: 0 0 32px; padding: 20px 24px; background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 16px;">
                <p style="margin: 0 0 12px; font-size: 14px; font-weight: 700; color: #111827; text-transform: uppercase; letter-spacing: 0.04em;">Account details</p>
                <p style="margin: 0 0 8px; font-size: 15px; color: #374151;"><strong>Role:</strong> {{staffTypeLabel}}</p>
                {{#if staffRoleName}}
                <p style="margin: 0 0 8px; font-size: 15px; color: #374151;"><strong>Staff role:</strong> {{staffRoleName}}</p>
                {{/if}}
                <p style="margin: 0 0 8px; font-size: 15px; color: #374151;"><strong>Username:</strong> {{username}}</p>
                <p style="margin: 0; font-size: 15px; color: #374151;"><strong>Temporary password:</strong> {{temporaryPassword}}</p>
            </div>

            <div style="text-align: left; margin-bottom: 40px;">
                <a href="{{loginUrl}}" style="display: inline-block; background-color: #1a56db; color: #ffffff; text-decoration: none; font-size: 16px; font-weight: 600; padding: 16px 32px; border-radius: 12px;">Open CRM Login</a>
            </div>

            <!-- Divider -->
            <div style="height: 1px; background-color: #e5e7eb; margin: 32px 0;"></div>

            <p style="margin: 0; font-size: 14px; line-height: 1.6; color: #6b7280;">
                If you have any questions or need assistance, please contact your administrator or reply to this email. We're here to help.
            </p>

        </div>

        <!-- Footer -->
        <div style="text-align: center; margin-top: 32px;">
            <p style="margin: 0 0 8px; font-size: 12px; color: #9ca3af;">
                &copy; {{currentYear}} Fordan Solar. All rights reserved.
            </p>
            <p style="margin: 0; font-size: 12px; color: #9ca3af;">
                This email contains temporary login credentials intended only for the staff member named above.
            </p>
        </div>
    </div>

</body>
</html>
