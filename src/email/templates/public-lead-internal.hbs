<!DOCTYPE html>
<html>
<body style="font-family: sans-serif; color: #333; max-width: 600px; margin: 0 auto; padding: 24px;">
  <h2 style="color: #1a56db;">New Web Lead</h2>
  <table style="width: 100%; border-collapse: collapse;">
    <tr>
      <td style="padding: 8px 0; font-weight: bold; width: 140px;">Name</td>
      <td style="padding: 8px 0;">{{firstName}} {{lastName}}</td>
    </tr>
    <tr style="background: #f9fafb;">
      <td style="padding: 8px 0; font-weight: bold;">Email</td>
      <td style="padding: 8px 0;">{{email}}</td>
    </tr>
    <tr>
      <td style="padding: 8px 0; font-weight: bold;">Phone</td>
      <td style="padding: 8px 0;">{{phone}}</td>
    </tr>
    <tr style="background: #f9fafb;">
      <td style="padding: 8px 0; font-weight: bold;">Suburb</td>
      <td style="padding: 8px 0;">{{suburb}}{{#if postcode}} {{postcode}}{{/if}}</td>
    </tr>
    <tr>
      <td style="padding: 8px 0; font-weight: bold;">Interest</td>
      <td style="padding: 8px 0;">{{systemIntent}}</td>
    </tr>
  </table>
  <hr style="margin: 24px 0; border: none; border-top: 1px solid #e5e7eb;" />
  <p style="font-size: 12px; color: #9ca3af;">
    Customer ID: {{customerId}}<br />
    Job ID: {{jobId}}
  </p>
</body>
</html>
