<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign your quotation</title>
</head>
<body style="margin:0;padding:24px;background-color:#f2f4f6;font-family:'Plus Jakarta Sans',Arial,sans-serif;color:#191c1e;">
  <div style="max-width:600px;margin:0 auto;background-color:#ffffff;border-radius:18px;overflow:hidden;box-shadow:0 6px 24px rgba(17,24,39,0.08);">
    <div style="padding:24px 32px;background-color:#ffffff;border-bottom:1px solid #eceef0;">
      <div style="font-size:28px;line-height:1.1;font-weight:800;color:#855300;letter-spacing:-0.03em;">Fordan Solar</div>
    </div>
    <div style="padding:40px 32px;background-color:#2d3133;">
      <p style="margin:0 0 12px;font-size:12px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#ffddb8;">E-signature</p>
      <h1 style="margin:0 0 16px;font-size:28px;line-height:1.2;font-weight:800;color:#ffffff;">Please sign your quotation</h1>
      <p style="margin:0;font-size:17px;line-height:1.6;color:rgba(239,241,243,0.84);">Hi {{customerName}}, use the secure link below to review and electronically sign your quotation for order {{orderNumber}}.</p>
    </div>
    <div style="padding:32px;">
      <p style="margin:0 0 20px;font-size:15px;line-height:1.7;color:#534434;">Reference: <strong>{{referenceCode}}</strong></p>
      <p style="margin:0 0 28px;">
        <a href="{{signingUrl}}" style="display:inline-block;padding:14px 28px;border-radius:12px;background-color:#855300;color:#ffffff;font-weight:700;text-decoration:none;font-size:16px;">Open signing page</a>
      </p>
      <p style="margin:0;font-size:13px;line-height:1.6;color:#6b7280;">If the button does not work, copy and paste this URL into your browser:<br><span style="word-break:break-all;">{{signingUrl}}</span></p>
    </div>
    <div style="padding:20px 32px;background-color:#f7f9fb;border-top:1px solid #eceef0;font-size:12px;color:#6b7280;">
      © {{currentYear}} Fordan Solar. This link is personal to you; do not forward if you did not request it.
    </div>
  </div>
</body>
</html>
