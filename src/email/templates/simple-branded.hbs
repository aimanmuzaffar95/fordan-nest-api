<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{brandHeaderName}}</title>
  </head>
  <body style="margin: 0; padding: 12px; background: {{pageBgHex}}; font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;">
    <div style="max-width: 560px; margin: 0 auto; background: #fff; border-radius: 12px; overflow: hidden; border: 1px solid {{borderHex}};">
      <div style="padding: 16px 20px; border-bottom: 1px solid {{borderHex}};">
        {{#if brandLogoUrl}}
          <div style="display:flex; align-items:center; gap:12px;">
            <img src="{{brandLogoUrl}}" alt="{{brandHeaderName}} logo" style="height:34px; width:auto; display:block;" />
            <div style="font-size: 22px; font-weight: 800; color: {{primaryHex}};">{{brandHeaderName}}</div>
          </div>
        {{else}}
          <div style="font-size: 22px; font-weight: 800; color: {{primaryHex}};">{{brandHeaderName}}</div>
        {{/if}}
      </div>

      <div style="padding: 20px; background: {{heroBgHex}};">
        <p style="margin: 0 0 8px; font-size: 10px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: {{heroAccentHex}};">
          {{compiledKicker}}
        </p>
        <h1 style="margin: 0 0 10px; font-size: 20px; font-weight: 800; color: #fff;">{{compiledHeroTitle}}</h1>
        <p style="margin: 0; font-size: 15px; line-height: 1.5; color: {{heroLeadHex}};">{{compiledHeroIntro}}</p>
      </div>

      <div style="padding: 20px; color: {{bodyTextHex}};">
        <div style="padding: 14px; border-radius: 10px; background: {{cardBgHex}}; border: 1px solid {{borderHex}}; color: {{bodyMutedHex}}; line-height: 1.6;">
          {{{compiledBodyHtml}}}
        </div>

        {{#if ctaUrl}}
          {{#if ctaLabel}}
            <div style="margin-top: 14px;">
              <a href="{{ctaUrl}}" style="display: inline-block; padding: 12px 18px; border-radius: 10px; background: {{primaryHex}}; color: #fff; font-weight: 700; text-decoration: none;">
                {{ctaLabel}}
              </a>
            </div>
          {{/if}}
        {{/if}}
      </div>

      <div style="padding: 16px 20px; background: {{cardBgHex}}; font-size: 12px; color: #6b7280; border-top: 1px solid {{borderHex}};">
        <div style="font-weight: 800; margin-bottom: 8px; color: {{heroBgHex}};">{{footerBrandName}}</div>
        <p style="margin: 0 0 6px;">{{compiledFooterLine1}}</p>
        <p style="margin: 0;">{{compiledFooterLine2}}</p>
      </div>
    </div>
  </body>
</html>

