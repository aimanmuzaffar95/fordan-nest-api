<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <title>Quotation</title>
</head>
<body style="margin:0;padding:0;background-color:{{pageBgHex}};font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:{{bodyTextHex}};-webkit-text-size-adjust:100%;">
  <!-- Preheader: shows in inbox preview, hidden in the email body -->
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">{{{compiledHeroIntro}}}&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:{{pageBgHex}};">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:100%;background-color:#ffffff;border-radius:12px;overflow:hidden;border:1px solid {{borderHex}};">

          <!-- Header -->
          <tr>
            <td style="padding:20px 32px;border-bottom:1px solid {{borderHex}};">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  {{#if brandLogoUrl}}
                  <td style="vertical-align:middle;padding-right:12px;">
                    <img src="{{brandLogoUrl}}" alt="{{brandHeaderName}}" height="32" style="height:32px;max-width:170px;display:block;border:0;">
                  </td>
                  {{/if}}
                  <td style="vertical-align:middle;font-size:22px;line-height:1.2;font-weight:800;color:{{primaryHex}};letter-spacing:-0.02em;">{{brandHeaderName}}</td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Hero -->
          <tr>
            <td style="padding:36px 32px;background-color:{{heroBgHex}};">
              <p style="margin:0 0 10px;font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:{{heroAccentHex}};">{{{compiledKicker}}}</p>
              <h1 style="margin:0 0 12px;font-size:27px;line-height:1.25;font-weight:800;color:#ffffff;">{{{compiledHeroTitle}}}</h1>
              <p style="margin:0;font-size:16px;line-height:1.6;color:{{heroLeadHex}};">{{{compiledHeroIntro}}}</p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:28px 32px 32px;">
              <p style="margin:0 0 24px;font-size:15px;line-height:1.7;color:{{bodyMutedHex}};">{{{compiledIntroParagraph}}}</p>

              <!-- Project summary -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;background-color:{{cardBgHex}};border:1px solid {{borderHex}};border-radius:10px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size:14px;line-height:1.5;color:{{bodyTextHex}};">
                      <tr>
                        <td width="140" style="padding:3px 12px 3px 0;color:{{bodyMutedHex}};white-space:nowrap;">Order</td>
                        <td style="padding:3px 0;font-weight:700;">{{orderNumber}}</td>
                      </tr>
                      <tr>
                        <td width="140" style="padding:3px 12px 3px 0;color:{{bodyMutedHex}};white-space:nowrap;">System type</td>
                        <td style="padding:3px 0;">{{systemTypeLabel}}</td>
                      </tr>
                      <tr>
                        <td width="140" style="padding:3px 12px 3px 0;color:{{bodyMutedHex}};white-space:nowrap;">Solar array</td>
                        <td style="padding:3px 0;">{{systemSizeLabel}}</td>
                      </tr>
                      <tr>
                        <td width="140" style="padding:3px 12px 3px 0;color:{{bodyMutedHex}};white-space:nowrap;">Battery storage</td>
                        <td style="padding:3px 0;">{{batterySizeLabel}}</td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <h2 style="margin:0 0 12px;font-size:17px;line-height:1.3;font-weight:800;color:{{bodyTextHex}};">Quotation breakdown</h2>

              <!-- Line items -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin:0 0 4px;">
                <tr>
                  <td style="padding:8px 0;border-bottom:2px solid {{borderHex}};font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:{{bodyMutedHex}};">Item</td>
                  <td align="right" style="padding:8px 0 8px 12px;border-bottom:2px solid {{borderHex}};font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:{{bodyMutedHex}};white-space:nowrap;">Qty</td>
                  <td align="right" style="padding:8px 0 8px 16px;border-bottom:2px solid {{borderHex}};font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:{{bodyMutedHex}};white-space:nowrap;">Unit</td>
                  <td align="right" style="padding:8px 0 8px 16px;border-bottom:2px solid {{borderHex}};font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:{{bodyMutedHex}};white-space:nowrap;">Total</td>
                </tr>
                {{#each proposalItems}}
                <tr>
                  <td style="padding:12px 0;border-bottom:1px solid {{../borderHex}};font-size:14px;line-height:1.5;color:{{../bodyTextHex}};">
                    <span style="font-weight:700;">{{label}}</span>
                    {{#if subtitle}}<br><span style="font-size:12px;color:{{../bodyMutedHex}};">{{subtitle}}</span>{{/if}}
                  </td>
                  <td align="right" style="padding:12px 0 12px 12px;border-bottom:1px solid {{../borderHex}};font-size:14px;color:{{../bodyTextHex}};white-space:nowrap;vertical-align:top;">{{quantity}}</td>
                  <td align="right" style="padding:12px 0 12px 16px;border-bottom:1px solid {{../borderHex}};font-size:14px;color:{{../bodyTextHex}};white-space:nowrap;vertical-align:top;">{{proposalUnitPrice}}</td>
                  <td align="right" style="padding:12px 0 12px 16px;border-bottom:1px solid {{../borderHex}};font-size:14px;font-weight:700;color:{{../bodyTextHex}};white-space:nowrap;vertical-align:top;">{{lineTotal}}</td>
                </tr>
                {{/each}}
              </table>

              <!-- Total bar -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:20px 0 28px;background-color:{{totalBarBgHex}};border-radius:10px;">
                <tr>
                  <td style="padding:18px 22px;font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:{{totalBarLabelHex}};vertical-align:middle;">Total project investment</td>
                  <td align="right" style="padding:18px 22px;font-size:26px;line-height:1.1;font-weight:800;color:#ffffff;vertical-align:middle;white-space:nowrap;">{{proposalTotal}}</td>
                </tr>
              </table>

              <!-- Next steps -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:{{cardBgHex}};border:1px solid {{borderHex}};border-radius:10px;">
                <tr>
                  <td style="padding:20px 22px;">
                    <h3 style="margin:0 0 12px;font-size:15px;line-height:1.3;font-weight:800;color:{{bodyTextHex}};">What happens next</h3>
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="font-size:14px;line-height:1.65;color:{{bodyMutedHex}};">
                      <tr>
                        <td width="24" style="padding:0 0 8px;font-weight:700;color:{{primaryHex}};vertical-align:top;">1.</td>
                        <td style="padding:0 0 8px;">{{{compiledNext1}}}</td>
                      </tr>
                      <tr>
                        <td width="24" style="padding:0 0 8px;font-weight:700;color:{{primaryHex}};vertical-align:top;">2.</td>
                        <td style="padding:0 0 8px;">{{{compiledNext2}}}</td>
                      </tr>
                      <tr>
                        <td width="24" style="padding:0;font-weight:700;color:{{primaryHex}};vertical-align:top;">3.</td>
                        <td style="padding:0;">{{{compiledNext3}}}</td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding:24px 32px;background-color:{{cardBgHex}};border-top:1px solid {{borderHex}};">
              <p style="margin:0 0 10px;font-size:15px;line-height:1.2;font-weight:800;color:{{heroBgHex}};">{{footerBrandName}}</p>
              <p style="margin:0 0 4px;font-size:12px;line-height:1.6;color:{{bodyMutedHex}};">{{{compiledFooterLine1}}}</p>
              <p style="margin:0;font-size:12px;line-height:1.6;color:{{bodyMutedHex}};">{{{compiledFooterLine2}}}</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
