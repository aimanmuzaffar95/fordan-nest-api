<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <title>Thanks for reaching out</title>
</head>
<body style="margin:0;padding:0;background-color:#f2f4f6;font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#191c1e;-webkit-text-size-adjust:100%;">
  <!-- Preheader: shows in inbox preview, hidden in the email body -->
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">We received your enquiry and our team will be in touch soon.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f2f4f6;">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:100%;background-color:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #eceef0;">

          <!-- Header -->
          <tr>
            <td style="padding:20px 32px;border-bottom:1px solid #eceef0;font-size:22px;line-height:1.2;font-weight:800;color:#855300;letter-spacing:-0.02em;">Fordan Solar</td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:28px 32px;">
              <h1 style="margin:0 0 14px;font-size:22px;line-height:1.3;font-weight:800;color:#191c1e;">Thanks for reaching out, {{firstName}}.</h1>
              <p style="margin:0 0 16px;font-size:15px;line-height:1.7;color:#534434;">We've received your enquiry and a member of our team will be in touch with you soon to talk through the next steps for your solar project.</p>
              <p style="margin:0;font-size:14px;line-height:1.6;color:#534434;">— The Fordan Solar team</p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding:20px 32px;background-color:#f7f9fb;border-top:1px solid #eceef0;">
              <p style="margin:0;font-size:12px;line-height:1.6;color:#534434;">You are receiving this email because you submitted an enquiry to Fordan Solar.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
