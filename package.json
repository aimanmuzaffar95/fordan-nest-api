{
  "name": "fordan-solar-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true,maxRetries:5,retryDelay:100})\"",
    "build": "npm run clean && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "migration:show": "TS_NODE_TRANSPILE_ONLY=1 node ./node_modules/typeorm/cli-ts-node-commonjs.js migration:show -d src/database/data-source.ts",
    "migration:renumber": "TS_NODE_TRANSPILE_ONLY=1 node -r ts-node/register src/database/renumber-legacy-migrations.ts",
    "migration:run": "npm run migration:renumber && TS_NODE_TRANSPILE_ONLY=1 node ./node_modules/typeorm/cli-ts-node-commonjs.js migration:run -d src/database/data-source.ts",
    "migration:revert": "TS_NODE_TRANSPILE_ONLY=1 node ./node_modules/typeorm/cli-ts-node-commonjs.js migration:revert -d src/database/data-source.ts",
    "migration:generate": "TS_NODE_TRANSPILE_ONLY=1 node ./node_modules/typeorm/cli-ts-node-commonjs.js migration:generate src/migrations/AutoMigration -d src/database/data-source.ts",
    "check:migrations": "node scripts/check-entity-migrations.mjs",
    "check:solar-simulation": "node scripts/check-solar-simulation-reference.mjs",
    "seed:dev": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "seed:run": "node dist/database/seed.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1019.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@types/pdfkit": "^0.17.5",
    "ansis": "^4.2.0",
    "arg": "^4.1.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "clipper-lib": "^6.4.2",
    "dejavu-fonts-ttf": "^2.37.3",
    "handlebars": "^4.7.8",
    "helmet": "^8.3.0",
    "imapflow": "^1.6.5",
    "jpeg-js": "^0.4.4",
    "mailparser": "^3.9.14",
    "mysql2": "^3.14.0",
    "nodemailer": "^8.0.3",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.19.0",
    "pngjs": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.6",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/clipper-lib": "^6.4.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.11",
    "@types/pngjs": "^6.0.5",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.2",
    "available-typed-arrays": "^1.0.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "sql.js": "^1.14.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testSequencer": "<rootDir>/../test/jest-test-sequencer.cjs",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
